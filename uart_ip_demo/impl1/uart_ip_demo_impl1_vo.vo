  gnd DRIVEGND( .PWR0(GNDI));
  UASLICEREG0037 \uart_tx/tx_out.ff_inst ( .DL(DI0_dly), .DF(VCCI), 
    .CLK(CLK_dly), .LSR(LSR_NOTIN), .CE(VCCI), .Q(Q0));
  vcc DRIVEVCC( .Z(VCCI));
  inverter LSR_INVERTERIN( .I(LSR_dly), .Z(LSR_NOTIN));

  specify
    (D0 => F0) = (0:0:0,0:0:0);
    (B0 => F0) = (0:0:0,0:0:0);
    (A0 => F0) = (0:0:0,0:0:0);
