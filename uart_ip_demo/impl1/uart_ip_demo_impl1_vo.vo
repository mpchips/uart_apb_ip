module UALUT40036 ( input A, B, C, D, output Z );

  LUT4 #("0xCCBB") INST10( .A(A), .B(B), .C(C), .D(D), .Z(Z));
endmodule

module UASLICEREG0037 ( input DL, DF, CLK, LSR, CE, output Q );

  SLICEREG INST10( .DL(DL), .DF(DF), .CLK(CLK), .LSR(LSR), .CE(CE), .Q(Q));
  defparam INST10.REGSET = "SET";
  defparam INST10.LSRMODE = "LSR";
  defparam INST10.SEL = "DL";
  defparam INST10.GSR = "DISABLED";
  defparam INST10.ASYNC = "YES";
endmodule

