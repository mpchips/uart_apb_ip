module txd ( input PADDO, output txd );
  wire   GNDI;

  SEIO33_CORE_B \txd_pad.bb_inst ( .B(txd), .O(), .I(PADDO), .T(GNDI), 
    .I3CRESEN(GNDI), .I3CWKPU(GNDI));
  gnd DRIVEGND( .PWR0(GNDI));

  specify
    (PADDO => txd) = (0:0:0,0:0:0);
    $width (posedge txd, 0:0:0);
    $width (negedge txd, 0:0:0);
  endspecify

endmodule

module SEIO33_CORE_B ( inout B, output O, input I, T, I3CRESEN, I3CWKPU );

  SEIO33_CORE INST10( .B(B), .O(O), .I(I), .T(T), .I3CRESEN(I3CRESEN), 
    .I3CWKPU(I3CWKPU));
  defparam INST10.PULLMODE = "NONE";
endmodule

