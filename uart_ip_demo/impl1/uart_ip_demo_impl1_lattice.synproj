# Device Configuration
-a "LFD2NX"
-p LFD2NX-40
-t CABGA256
-sp "9_High-Performance_1.0V"

# Synthesis Strategy Options
-frequency 200
-optimization_goal Timing
-bram_utilization 100
-ramstyle Auto
-romstyle auto
-dsp_utilization 100
-use_dsp 1
-use_carry_chain 1
-carry_chain_length 0
-resource_sharing 1
-propagate_constants 1
-remove_duplicate_regs 1
-max_fanout 1000
-fsm_encoding_style Auto
-fix_gated_clocks 1
-loop_limit 1950
-use_io_reg auto
-use_dcc_insertion none
-drc_cfg 35103300 20
-use_io_insertion 1
-force_gsr No
-resolve_mixed_drivers 0

# Search Paths
-path "C:/lscc/radiant/2026.1.1/ispfpga/jd5s00/data"
-path "."
-path ".."
-path "../../src"
-path "../../tb"

# PMI Library Files
-ver "C:/lscc/radiant/2026.1.1/ip/pmi/pmi_lfd2nx.v"
-lib pmi -vhd "C:/lscc/radiant/2026.1.1/ip/pmi/pmi_lfd2nx.vhd"

# Source Files
-ver "../../src/apb_decoder.v"
-ver "../../src/apb_interface.v"
-ver "../../src/apb_rdata_mux.v"
-ver "../../src/debouncer.v"
-ver "../../src/fifo.v"
-ver "../../src/rx_controller.v"
-ver "../../src/rx_counter.v"
-ver "../../src/rx_shifter.v"
-ver "../../src/synchronizer.v"
-ver "../../src/uart_apb_top.v"
-ver "../../src/uart_rx.v"
-ver "../../src/uart_tx.v"
-ver "../../src/sticky_flag.v"
-path ".."
-top uart_apb_top
# Output Configuration
-udb "uart_ip_demo_impl1_rtl.udb"
-output_hdl "uart_ip_demo_impl1.vm"
